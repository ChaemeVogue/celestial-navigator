# Use the mock data in src/api/mock. Set to "false" to call the Django backend.
VITE_USE_MOCKS=true

# Where the Vite dev server forwards /api and /media (dev only, never sent to the browser).
API_PROXY_TARGET=http://localhost:8000

# Leave empty in dev (the proxy handles it). Set to the backend's URL only for a
# build that talks to a backend on a different host, e.g. https://api.example.org
VITE_API_BASE=
